# name: test/sql/window/test_window_partition_expr_pushdown.test
# group: [window]

# Window partition-key expression pushdown (pushdown_window.cpp)
#
# A filter above a window can be pushed below it when the filter is whole-partition for every
# window expression: either it only references partition columns, or it is a comparison whose one
# side is expression-equivalent to a partition key expression and whose other side is a constant.
#
# The id != 52 / id != 0 cases are the safety discriminators: removing a row inside a partition
# changes the row numbering of the remaining rows, so pushing those filters below the window would
# produce extra rows (e.g. 53 in the partition-5 case, 3 in the constant-partition case).

statement ok
CREATE TABLE pf(id INTEGER, v INTEGER);

statement ok
INSERT INTO pf FROM (SELECT i AS id, i AS v FROM range(0, 100) tbl(i));

# control: filter on a bare partition column is pushed (pre-existing behavior)
query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY id ORDER BY v) AS rn FROM pf) sub
WHERE id = 42
ORDER BY id;
----
42	42

# filter expression-equivalent to the partition key expression (floor(id/10) = 5) is pushed
query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY floor(id / 10.0) ORDER BY v) AS rn FROM pf) sub
WHERE floor(id / 10.0) = 5.0 AND rn <= 3
ORDER BY id;
----
50	50
51	51
52	52

# constant side on the left of the comparison
query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY floor(id / 10.0) ORDER BY v) AS rn FROM pf) sub
WHERE 5.0 = floor(id / 10.0) AND rn <= 3
ORDER BY id;
----
50	50
51	51
52	52

# safety: id != 52 removes a row INSIDE partition 5 - the filter must stay above the window,
# so the correct answer drops the rn=3 row instead of pulling 53 into the top-3
query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY floor(id / 10.0) ORDER BY v) AS rn FROM pf) sub
WHERE id != 52 AND rn <= 3
ORDER BY id;
----
0	0
1	1
2	2
10	10
11	11
12	12
20	20
21	21
22	22
30	30
31	31
32	32
40	40
41	41
42	42
50	50
51	51
60	60
61	61
62	62
70	70
71	71
72	72
80	80
81	81
82	82
90	90
91	91
92	92

# safety: constant partition cannot be split - the filter must stay above the window
query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY 1 ORDER BY v) AS rn FROM pf) sub
WHERE id != 0 AND rn <= 3
ORDER BY id;
----
1	1
2	2

# safety: predicate on a partition-underlying column but not equivalent to the partition
# expression itself (floor(id/10) + v = 55) stays above the window
query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY floor(id / 10.0) ORDER BY v) AS rn FROM pf) sub
WHERE floor(id / 10.0) + v = 55.0 AND rn <= 3
ORDER BY id;
----
50	50

# non-equality comparison anchored on the partition expression is whole-partition and pushed
query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY floor(id / 10.0) ORDER BY v) AS rn FROM pf) sub
WHERE floor(id / 10.0) >= 8.0 AND rn <= 2
ORDER BY id;
----
80	80
81	81
90	90
91	91

# bare partition column + non-equality filter on it: pushed (pre-existing behavior, whole partitions)
query I
SELECT count(*) FROM (SELECT *, row_number() OVER (PARTITION BY id ORDER BY v) AS rn FROM pf) sub
WHERE id != 52 AND rn <= 3;
----
99

# multiple window expressions: anchored for the function-partitioned one, subset for the
# single-column-partitioned one - the filter is whole-partition for both and pushed
query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY floor(id / 10.0) ORDER BY v) AS rn1,
                          row_number() OVER (PARTITION BY id ORDER BY v) AS rn2 FROM pf) sub
WHERE floor(id / 10.0) = 5.0 AND rn2 <= 2
ORDER BY id;
----
50	50
51	51
52	52
53	53
54	54
55	55
56	56
57	57
58	58
59	59

# multiple window expressions: anchored for the first but neither anchored nor subset for the
# second (partitioned by v) - the filter stays above the window
query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY floor(id / 10.0) ORDER BY v) AS rn1,
                          row_number() OVER (PARTITION BY v ORDER BY v) AS rn2 FROM pf) sub
WHERE floor(id / 10.0) = 5.0 AND rn2 <= 2
ORDER BY id;
----
50	50
51	51
52	52
53	53
54	54
55	55
56	56
57	57
58	58
59	59

# NULL partition key: the NULL partition is dropped entirely by the anchored filter, pushed or not
statement ok
CREATE TABLE pfn(id INTEGER, v INTEGER);

statement ok
INSERT INTO pfn VALUES (NULL, 0), (50, 50), (51, 51), (55, 55);

query II
SELECT id, v FROM (SELECT *, row_number() OVER (PARTITION BY floor(id / 10.0) ORDER BY v) AS rn FROM pfn) sub
WHERE floor(id / 10.0) = 5.0 AND rn <= 3
ORDER BY id;
----
50	50
51	51
55	55

# ---------------------------------------------------------------------------------------------
# Shapes whose anchored filter actually reaches PushdownWindow: the floor family above is
# blocked earlier by the throwing-expression guard in pushdown_projection (division can throw),
# so use throw-free functions to exercise the expression-equivalence path end to end.
# ---------------------------------------------------------------------------------------------
statement ok
CREATE TABLE ps(k INTEGER, s VARCHAR);

statement ok
INSERT INTO ps VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma'), (4, 'Alpha'), (5, 'bet'), (6, 'alpha'), (7, 'x');

# anchored filter on lower(s) partition: pushed below the window; whole-partition so push or not
# the result is identical - partition 'alpha' = {k: 1, 4, 6}, top-2 by k
query II
SELECT k, s FROM (SELECT *, row_number() OVER (PARTITION BY lower(s) ORDER BY k) AS rn FROM ps) sub
WHERE lower(s) = 'alpha' AND rn <= 2
ORDER BY k;
----
1	alpha
4	Alpha

# anchored filter on length(s) partition: partition 5 = {k: 1, 3, 4, 6}, top-2 by k
query II
SELECT k, s FROM (SELECT *, row_number() OVER (PARTITION BY length(s) ORDER BY k) AS rn FROM ps) sub
WHERE length(s) = 5 AND rn <= 2
ORDER BY k;
----
1	alpha
3	gamma

# safety: filter on the underlying column (s = 'alpha') splits the lower(s) partition
# {alpha, Alpha, alpha} - it must stay above the window. Correct semantics: rn over the FULL
# partition is 1(k=1), 2(k=4), 3(k=6); s='alpha' removes k=4, and rn<=2 then drops k=6 (rn=3),
# leaving only k=1. An unsafe push would wrongly produce k=1 and k=6.
query II
SELECT k, s FROM (SELECT *, row_number() OVER (PARTITION BY lower(s) ORDER BY k) AS rn FROM ps) sub
WHERE s = 'alpha' AND rn <= 2
ORDER BY k;
----
1	alpha

# inequality anchored on the partition expression is whole-partition and pushed
query II
SELECT k, s FROM (SELECT *, row_number() OVER (PARTITION BY lower(s) ORDER BY k) AS rn FROM ps) sub
WHERE lower(s) != 'alpha' AND rn <= 1
ORDER BY k;
----
2	beta
3	gamma
5	bet
7	x

