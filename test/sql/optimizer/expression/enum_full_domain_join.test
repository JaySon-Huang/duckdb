# name: test/sql/optimizer/expression/enum_full_domain_join.test
# description: Full-domain ENUM (NOT) IN rewritten inside join conditions, and NOT-pushdown scope for constant_or_null
# group: [expression]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CREATE TYPE mood AS ENUM('sad', 'ok', 'happy');

# nullable column with all domain values plus one NULL row
statement ok
CREATE TABLE a AS SELECT (range % 3)::INTEGER AS k, ['sad', 'ok', 'happy'][1 + range % 3]::mood AS m FROM range(12);

statement ok
CREATE TABLE b AS SELECT (range % 3)::INTEGER AS k, range::INTEGER AS v FROM range(12);

statement ok
INSERT INTO a VALUES (99, NULL);

# 1. INNER join: the single-side ON predicate is pushed into a filter on a, where the
#    NOT-IN over the full domain collapses to an empty result
query II
explain
SELECT count(*) FROM a JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
physical_plan	<REGEX>:.*EMPTY.*

query I
SELECT count(*) FROM a JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
0

# 2. INNER join with IN over the full domain: pushed down as an IS NOT NULL filter
query II
explain
SELECT count(*) FROM a JOIN b ON a.k = b.k AND a.m IN ('sad', 'ok', 'happy');
----
physical_plan	<REGEX>:.*m IS NOT NULL.*

query I
SELECT count(*) FROM a JOIN b ON a.k = b.k AND a.m IN ('sad', 'ok', 'happy');
----
48

# 3. LEFT join, preserved-side ON predicate: the predicate cannot be pushed into a filter,
#    so it stays in the join condition. The IN rewrite fires there and NOT is pushed into
#    constant_or_null: NOT constant_or_null(true, m) becomes constant_or_null(false, m)
query II
explain
SELECT count(*) FROM a LEFT JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
physical_plan	<REGEX>:.*Conditions:.*k = k,.*constant_or_null\(false, m\).*

query I
SELECT count(*) FROM a LEFT JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
13

# the condition is never true, so no row of b ever matches: b.v is always NULL
query I
SELECT count(b.v) FROM a LEFT JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
0

# 4. LEFT join, preserved-side IN over the full domain: constant_or_null stays in the join
#    condition (matches on non-NULL m; the NULL row survives unmatched)
query II
explain
SELECT count(*) FROM a LEFT JOIN b ON a.k = b.k AND a.m IN ('sad', 'ok', 'happy');
----
physical_plan	<REGEX>:.*constant_or_null\(true, m\).*

query I
SELECT count(*) FROM a LEFT JOIN b ON a.k = b.k AND a.m IN ('sad', 'ok', 'happy');
----
49

# 5. RIGHT join with the predicate on the preserved side behaves like case 3
query II
explain
SELECT count(*) FROM b RIGHT JOIN a ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
physical_plan	<REGEX>:.*Conditions:.*k = k,.*constant_or_null\(false, m\).*

query I
SELECT count(*) FROM b RIGHT JOIN a ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
13

# 6. LEFT join degeneration: a condition that is FALSE-or-NULL (constant_or_null(false, m))
#    can never match, so the right side is replaced by an empty result
query II
explain
SELECT count(*) FROM a LEFT JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
physical_plan	<REGEX>:.*HASH_JOIN.*Join Type: LEFT.*constant_or_null\(false, m\).*EMPTY_RESULT.*

query I
SELECT count(*) FROM a LEFT JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
13

query I
SELECT count(b.v) FROM a LEFT JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
0

# the IN direction does not degenerate: constant_or_null(true, m) is TRUE-or-NULL, and a
# NULL condition still rejects a pair, so non-NULL rows can still match
query I
SELECT count(*) FROM a LEFT JOIN b ON a.k = b.k AND a.m IN ('sad', 'ok', 'happy');
----
49

# 7. semi join over a never-matching condition produces no rows
query I
SELECT count(*) FROM a WHERE EXISTS (SELECT 1 FROM b WHERE b.k = a.k AND a.m NOT IN ('sad', 'ok', 'happy'));
----
0

# 8. anti join over a never-matching condition keeps every row
query I
SELECT count(*) FROM a WHERE NOT EXISTS (SELECT 1 FROM b WHERE b.k = a.k AND a.m NOT IN ('sad', 'ok', 'happy'));
----
13

# 9. full outer join is not degenerated (both sides contribute rows even without matches)
query II
explain
SELECT count(*) FROM a FULL OUTER JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
physical_plan	<REGEX>:.*HASH_JOIN.*

query I
SELECT count(*) FROM a FULL OUTER JOIN b ON a.k = b.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
25

# 10. DML CTE plans skip statistics propagation entirely, so the join is not degenerated -
#     the INSERT must still run exactly once
statement ok
CREATE TABLE guard_check(k INTEGER, m mood);

statement ok
INSERT INTO guard_check VALUES (1, 'sad');

query I
WITH ins AS (INSERT INTO guard_check VALUES (99, NULL) RETURNING *) SELECT count(*) FROM a LEFT JOIN ins ON a.k = ins.k AND a.m NOT IN ('sad', 'ok', 'happy');
----
13

query I
SELECT count(*) FROM guard_check;
----
2

query I
SELECT count(*) FROM guard_check WHERE m IS NULL;
----
1
