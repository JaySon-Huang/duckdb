# name: test/optimizer/minmax_char_length.test
# description: Test folding of MIN/MAX over character-length functions from string statistics
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

require no_alternative_verify

# has_unicode/has_min_string_length semantics rely on the V2_0_0+ storage format
statement ok
SET storage_compatibility_version='latest';

statement ok
ATTACH '{TEST_DIR}/minmax_char_length.duckdb' AS db (ROW_GROUP_SIZE 2048)

statement ok
USE db

# Four ASCII-only row groups, byte length (i % 100) + 1, i.e. 1..100
statement ok
CREATE TABLE t_ascii AS (SELECT i, repeat('a', (i % 100) + 1) AS s FROM range(8192) _(i));

# Unicode in every row group: even rows are 'é' plus 0..48 'b's (1..49 characters,
# 2..50 bytes), odd rows are 'a' plus a digit (2..3 characters)
statement ok
CREATE TABLE t_uni AS (SELECT i, CASE WHEN i % 2 = 0 THEN 'é' || repeat('b', i % 50) ELSE 'a' || (i % 10) END AS s FROM range(8192) _(i));

# Row groups 0-3 are ASCII-only with lengths 10..99, row group 4 (100 rows) contains
# unicode strings '日' plus 0..9 'y's (1..10 characters, 3..12 bytes)
statement ok
CREATE TABLE t_mix AS (SELECT repeat('x', (i % 90) + 10) AS s FROM range(8192) _(i));

statement ok
INSERT INTO t_mix SELECT '日' || repeat('y', i % 10) FROM range(100) _(i);

# A list column: length() counts list elements, unrelated to string statistics
statement ok
CREATE TABLE t_list AS (SELECT [1, 2, 3] AS l);

# Reopen to clear version info
statement ok
ATTACH '{TEST_DIR}/tmp_minmax_char_length.duckdb' AS tmp

statement ok
USE tmp

statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/minmax_char_length.duckdb' AS db (ROW_GROUP_SIZE 2048)

statement ok
USE db

statement ok
DETACH tmp

# ASCII-only columns: character counts equal byte counts, so the aggregates fold
query II
EXPLAIN SELECT max(length(s)), min(length(s)) FROM t_ascii
----
physical_plan	<!REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT max(length(s)), min(length(s)) FROM t_ascii
----
100	1

# Aliases resolve to the same function and fold as well
query II
EXPLAIN SELECT max(char_length(s)), min(character_length(s)) FROM t_ascii
----
physical_plan	<!REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT max(char_length(s)), min(character_length(s)) FROM t_ascii
----
100	1

# A filter that drops entire row groups leaves only fully-kept ASCII partitions,
# which still fold - same as max(strlen(s)) WHERE i >= 2048 AND i < 6144
query II
EXPLAIN SELECT max(length(s)) FROM t_ascii WHERE i >= 2048 AND i < 6144
----
physical_plan	<!REGEX>:.*UNGROUPED_AGGREGATE.*

query I
SELECT max(length(s)) FROM t_ascii WHERE i >= 2048 AND i < 6144
----
100

# length() over a list counts elements - no string statistics, no folding
query II
EXPLAIN SELECT max(length(l)) FROM t_list
----
physical_plan	<REGEX>:.*UNGROUPED_AGGREGATE.*

# A unicode-possible column must not fold character lengths - the byte-length
# variants still fold from the same statistics
query II
EXPLAIN SELECT max(char_length(s)), min(char_length(s)) FROM t_uni
----
physical_plan	<REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT max(char_length(s)), min(char_length(s)) FROM t_uni
----
49	1

query II
EXPLAIN SELECT max(strlen(s)), min(strlen(s)) FROM t_uni
----
physical_plan	<!REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT max(strlen(s)), min(strlen(s)) FROM t_uni
----
50	2

# Mixed table, MAX: the unicode row group holds at most 12 bytes, below the exact
# candidate 99 from the ASCII row groups, so it is pruned and the aggregate folds
query II
EXPLAIN SELECT max(length(s)) FROM t_mix
----
physical_plan	<!REGEX>:.*UNGROUPED_AGGREGATE.*

query I
SELECT max(length(s)) FROM t_mix
----
99

# Mixed table, MIN: the unicode row group can hold a character count as low as
# ceil(3 / 4) = 1, below the exact candidate 10, so it must be scanned and the
# result merges the constant with the scan through a partial precompute
mode skip "This optimization is currently disabled due to issues with rowgroup reordering"

query II
EXPLAIN SELECT min(length(s)) FROM t_mix
----
physical_plan	<REGEX>:.*COALESCE.*least.*UNGROUPED_AGGREGATE.*

mode unskip

query I
SELECT min(length(s)) FROM t_mix
----
1

# The byte-length variant on the same table keeps folding without scanning
query I
SELECT max(strlen(s)) FROM t_mix
----
99

# Four-byte characters (U+20000) cap the character count at a quarter of the byte
# count - row groups 0-3 below hold 50..64 characters, row group 4 up to 10
# characters in at most 40 bytes, so its bound cannot hold the global maximum
statement ok
CREATE TABLE t_4byte_skip AS (SELECT repeat('x', 50 + (i % 15)) AS s FROM range(8192) _(i));

statement ok
INSERT INTO t_4byte_skip SELECT repeat('𠀀', 10 - (i % 10)) FROM range(100) _(i);

query II
EXPLAIN SELECT max(length(s)) FROM t_4byte_skip
----
physical_plan	<!REGEX>:.*UNGROUPED_AGGREGATE.*

query I
SELECT max(length(s)) FROM t_4byte_skip
----
64

# With shorter ASCII row groups (15..30) the same unicode row group can still hold
# up to 40 characters by its byte bound - MAX must not prune it and merges instead
statement ok
CREATE TABLE t_4byte_scan AS (SELECT repeat('x', 30 - (i % 16)) AS s FROM range(8192) _(i));

statement ok
INSERT INTO t_4byte_scan SELECT repeat('𠀀', 10 - (i % 10)) FROM range(100) _(i);

mode skip "This optimization is currently disabled due to issues with rowgroup reordering"

query II
EXPLAIN SELECT max(length(s)) FROM t_4byte_scan
----
physical_plan	<REGEX>:.*COALESCE.*greatest.*UNGROUPED_AGGREGATE.*

mode unskip

query I
SELECT max(length(s)) FROM t_4byte_scan
----
30

# Both length flavors independently prove the unicode row group cannot hold either
# maximum - byte bound 12 < 99 and character bound 10 < 99 - so it is pruned for
# both and the query folds without scanning
query II
EXPLAIN SELECT max(strlen(s)), max(length(s)) FROM t_mix
----
physical_plan	<!REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT max(strlen(s)), max(length(s)) FROM t_mix
----
99	99

# Cross-direction mix: strlen MIN is exact from unicode byte stats (3), while
# character MAX prunes that row group (12 < 99), so both fold without scanning
query II
EXPLAIN SELECT min(strlen(s)), max(length(s)) FROM t_mix
----
physical_plan	<!REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT min(strlen(s)), max(length(s)) FROM t_mix
----
3	99

# Same-direction MIN: unicode holds both minima (byte 3, character bound ceil(3/4)=1
# below the ASCII candidate 10), so character MIN cannot prune and the query scans
query II
EXPLAIN SELECT min(strlen(s)), min(length(s)) FROM t_mix
----
physical_plan	<REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT min(strlen(s)), min(length(s)) FROM t_mix
----
3	1

# Character MIN still cannot prune when the byte side is a maximum
query II
EXPLAIN SELECT max(strlen(s)), min(length(s)) FROM t_mix
----
physical_plan	<REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT max(strlen(s)), min(length(s)) FROM t_mix
----
99	1

# Aggregates that need every row keep the unicode row group in the scan set
query II
EXPLAIN SELECT max(length(s)), count(*) FROM t_mix
----
physical_plan	<REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT max(length(s)), count(*) FROM t_mix
----
99	8292

query II
EXPLAIN SELECT max(length(s)), min(s) FROM t_mix
----
physical_plan	<REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT max(length(s)), min(s) FROM t_mix
----
99	xxxxxxxxxx

# Strings short enough for exact prefix statistics: min(s) vetoes pruning, so the
# unicode row group is scanned even though max(length(s)) could fold from ASCII
statement ok
CREATE TABLE t_short AS (SELECT 'a' || (i % 10) AS s FROM range(8192) _(i));

statement ok
INSERT INTO t_short SELECT 'é' || repeat('b', i % 5) FROM range(100) _(i);

query II
EXPLAIN SELECT max(length(s)), min(s) FROM t_short
----
physical_plan	<REGEX>:.*UNGROUPED_AGGREGATE.*

query II
SELECT max(length(s)), min(s) FROM t_short
----
5	a0
